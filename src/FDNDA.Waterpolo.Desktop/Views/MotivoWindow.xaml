<Window x:Class="FDNDA.Waterpolo.Desktop.Views.MotivoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14"
        FocusManager.FocusedElement="{Binding ElementName=ReasonBox}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Label Content="_Motivo (obligatorio):" Target="{Binding ElementName=ReasonBox}" Padding="0,0,0,4" />
        <TextBox x:Name="ReasonBox" MaxLength="300" Padding="6" TextChanged="OnReasonChanged" AutomationProperties.AutomationId="DialogReason" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="AcceptButton" Content="Aceptar" IsDefault="True" IsEnabled="False" Click="OnAccept" MinWidth="100"
                    AutomationProperties.AutomationId="DialogAccept" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="100" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
