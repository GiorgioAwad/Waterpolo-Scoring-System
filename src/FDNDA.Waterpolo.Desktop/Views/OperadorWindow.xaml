<Window x:Class="FDNDA.Waterpolo.Desktop.Views.OperadorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marcador de Waterpolo FDNDA — Operador"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="20">
        <TextBlock Text="Identifíquese para abrir la sesión de mesa" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="#52606D" Margin="0,0,0,12"
                   Text="Su nombre se guarda con cada acción (goles, correcciones, cierres y reaperturas). Es una identificación local; no es una contraseña." />
        <Label Content="_Nombre del operador:" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <ComboBox x:Name="NameBox" IsEditable="True" MaxDropDownHeight="200" AutomationProperties.AutomationId="OperatorName" />
        <TextBlock x:Name="ErrorText" Foreground="#B71C1C" Margin="0,6,0,0" Visibility="Collapsed"
                   Text="Escriba su nombre (máximo 60 caracteres)." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Entrar" IsDefault="True" Click="OnAccept" MinWidth="100" AutomationProperties.AutomationId="OperatorAccept" />
            <Button Content="Salir" IsCancel="True" MinWidth="100" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
