<Window x:Class="FDNDA.Waterpolo.Desktop.Views.ImportarNominaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100" Height="680" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}" FontFamily="Segoe UI" FontSize="14">
    <DockPanel Margin="16">
        <!-- Encabezado -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CountsText}" Margin="0,4,0,0" AutomationProperties.AutomationId="ImportCounts" />
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Nada se guarda hasta pulsar «Importar». Las filas «Decidir» chocan con la nómina actual: elija qué hacer con cada una; el programa no supone que dos jugadores son el mismo por el nombre." />
        </StackPanel>

        <!-- Errores del archivo -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" BorderBrush="{StaticResource DangerBrush}"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Errores (fila y columna del archivo)" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Errors}" AutomationProperties.AutomationId="ImportErrors">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Avisos -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10"
                Visibility="{Binding HasNotices, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Notices}" AutomationProperties.AutomationId="ImportNotices">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" Foreground="{StaticResource MutedBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Resultado y botones -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Importar" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" MinWidth="110"
                        AutomationProperties.AutomationId="ConfirmImport" />
                <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="110" Margin="0"
                        AutomationProperties.AutomationId="CancelImport" />
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding PlanText}" TextWrapping="Wrap" FontWeight="SemiBold" AutomationProperties.AutomationId="ImportPlan" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"
                           AutomationProperties.AutomationId="ImportStatus" />
            </StackPanel>
        </DockPanel>

        <!-- Filas -->
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource LineBrush}"
                  SelectionMode="Single" RowHeaderWidth="0" Background="{StaticResource CardBrush}"
                  AutomationProperties.AutomationId="ImportRows" AutomationProperties.Name="Filas del archivo">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fila" Binding="{Binding Row}" Width="50" />
                <DataGridTextColumn Header="Equipo" Binding="{Binding Team}" Width="70" />
                <DataGridTextColumn Header="Jugador" Binding="{Binding Player}" Width="200" />
                <DataGridTextColumn Header="Gorro" Binding="{Binding Cap}" Width="60" />
                <DataGridTemplateColumn Header="Estado" Width="95">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Top" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusText}" Value="Decidir">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Decisión" Width="360">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Text"
                                      SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVisibility}}"
                                      AutomationProperties.AutomationId="{Binding Row, StringFormat='Decision{0}'}"
                                      AutomationProperties.Name="{Binding Row, StringFormat='Decisión de la fila {0}'}" Margin="2" VerticalAlignment="Top" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Detalle" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
