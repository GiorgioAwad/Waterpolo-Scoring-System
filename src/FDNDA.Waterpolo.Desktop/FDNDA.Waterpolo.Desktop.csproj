<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- El ejecutable entregado es FDNDA.Waterpolo.exe -->
    <AssemblyName>FDNDA.Waterpolo</AssemblyName>
    <RootNamespace>FDNDA.Waterpolo.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>Marcador de Waterpolo FDNDA</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FDNDA.Waterpolo.Application\FDNDA.Waterpolo.Application.csproj" />
    <!-- Infrastructure solo se usa desde el punto de composición (App.xaml.cs). -->
    <ProjectReference Include="..\FDNDA.Waterpolo.Infrastructure\FDNDA.Waterpolo.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

</Project>
